      "static/chunks/app/(fullscreen)/layout.js"
    ],
    "/(fullscreen)/showcase/charts/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(fullscreen)/showcase/charts/page.js"
    ],
    "/(docs)/showcase/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(docs)/showcase/page.js"
    ],
    "/(docs)/components/alert/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(docs)/components/alert/page.js"
    ]
